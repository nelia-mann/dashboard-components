{
    "source": "src/index.js",
    "module": "dist/all-cards.js",
    "targets": {
        "module": {
            "includeNodeModules": true,
            "optimize": true
        }
    },
    "scripts": {
        "watch": "parcel watch",
        "watch:bump": "chokidar 'dist/all-cards.js' -c 'python3 ~/ha-dev/bump_card_version.py --url-prefix /local/dashboard-components/dist/all-cards.js --browser-id 1db3188652520a60f9f807063d9cf8cc --browser-id 1592280c2352e3df0d5f399b361c5338' --polling --debounce 500",
        "build": "parcel build",
        "dev": "concurrently \"npm run watch\" \"npm run watch:bump\""
    },
    "devDependencies": {
        "@parcel/transformer-inline-string": "^2.16.3",
        "parcel": "^2.16.3"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "lit": "^3.3.1"
    }
}
